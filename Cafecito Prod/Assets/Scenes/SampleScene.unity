--- !u!114 &1310386427
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1310386425}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9e4b2219c2ff2546a4729434c8e328d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  hoverableObject: {fileID: 1883735089}
  onHover:
    m_PersistentCalls:
      m_Calls: []
  textToDisplay: "The newspaper is dated June 16, 1849, and reads: \u201CTodo jornalero
    tendr\xE1 una libreta en que se asentar\xE1n su nombre, se\xF1ales, jornal, adelantos
    y deudas, y no podr\xE1 mudarse de un punto a otro sin haber satisfecho previamente
    lo que debiere.\u201D (translation: \u201CEvery laborer shall have a workbook
    in which his name, marks, wages, advances, and debts shall be recorded, and he
    may not move from one place to another without first having satisfied what he
    owes.\u201D) "
